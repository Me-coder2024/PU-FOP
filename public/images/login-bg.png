<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Error 404</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link href="https://npf-prod-bucket.s3.ap-south-1.amazonaws.com/error-pages/favicon.ico" type="image/x-icon" rel="icon"/>
    <link href="https://npf-prod-bucket.s3.ap-south-1.amazonaws.com/error-pages/favicon.ico" type="image/x-icon" rel="shortcut icon"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap">
    <link rel="stylesheet" href="https://npf-prod-bucket.s3.ap-south-1.amazonaws.com/error-pages/httperror.css">
</head>
<body>
    <div id="notfound">
        <div class="notfound">
            <div class="content">
                <div class="notfound-error">
                    <h1 style="font-size:120px">404</h1>
                </div>
                <h2>Page Not Found</h2>
                <p>The page you are looking for might have been removed or renamed or is temporarily unavailable.</p>
            </div>
            <div class="errorimage">
                <img src="https://npf-prod-bucket.s3.ap-south-1.amazonaws.com/error-pages/Mediamodifier_400x400.png" alt="404" style="max-width:100%" />
            </div>
        </div>
        <img src="https://npf-prod-bucket.s3.ap-south-1.amazonaws.com/error-pages/rocket_images-min.webp" class="imageRocket" style="display:none;">
    </div>
    <div id="clouds">
        <div class="cloud x1"></div>
        <div class="cloud x1_5"></div>
        <div class="cloud x2"></div>
        <div class="cloud x3"></div>
        <div class="cloud x4"></div>
        <div class="cloud x5"></div>
    </div>
</body>
</html>