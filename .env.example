# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Config
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=paruluniversity.ac.in

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Groq AI
GROQ_API_KEY=your-groq-api-key

# SMTP Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=PU-FOP System
SMTP_FROM_EMAIL=noreply@paruluniversity.ac.in

# Release staging flags (keep false/production for production)
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ENABLE_PILOT_DEPARTMENTS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Workflow mail; never hard-code credentials. SMTP sender also uses RESEND_FROM_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PG_DIRECTOR_EMAIL=
# PPT storage uses the existing Supabase keys and private research-presentations bucket.
# No AWS credentials or S3 endpoint are required. Size/deadlines are database configuration.

# RPMS scheduled check-ins/reminders. Use CRON_SECRET with Vercel's automatic bearer header.
# For an external scheduler, RPMS_JOB_SECRET may be used instead.
CRON_SECRET=
RPMS_JOB_SECRET=
